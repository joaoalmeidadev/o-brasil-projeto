# Copie este arquivo para `.kamal/secrets` (já no .gitignore) e preencha.
# Kamal carrega cada linha como variável de ambiente.

# Senha do registry (ex.: GitHub PAT com permissão write:packages para GHCR)
KAMAL_REGISTRY_PASSWORD=

# URL do Postgres dentro do droplet (host = nome do accessory).
DATABASE_URL=postgresql://app:TROCAR_POSTGRES_PASSWORD@brasil-nao-aguenta-mais-postgres:5432/brasil_nao_aguenta_mais?schema=public

# Senha do Postgres (mantém em sync com a senha em DATABASE_URL)
POSTGRES_PASSWORD=TROCAR_POSTGRES_PASSWORD

# Loops.so (https://app.loops.so/settings/api)
LOOPS_API_KEY=
# Opcional: ID de transactional template para e-mail de boas-vindas
LOOPS_WELCOME_TRANSACTIONAL_ID=
